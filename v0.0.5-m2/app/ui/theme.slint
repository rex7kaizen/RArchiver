// Temalar: 0 = RArchiver Koyu Mor, 1 = RArchiver Açık Lavanta, 2 = Klasik (ZArchiver renkleri)
export global Theme {
    in-out property <int> index: 0;
    out property <color> bg: [#16101F, #F6F2FC, #181813][index];
    out property <color> toolbar: [#2A1F42, #6B3FC4, #313218][index];
    out property <color> toolbar-fg: [#EDE7F7, #FFFFFF, #F4F1E8][index];
    out property <color> text: [#F3EEFB, #1E1530, #FFFFFF][index];
    out property <color> text2: [#A89BC2, #6A5C85, #BBBBBB][index];
    out property <color> folder-front: [#B79CF0, #9B7BE0, #FFA726][index];
    out property <color> folder-back: [#8D6FD6, #6B3FC4, #EF6C00][index];
    out property <color> folder-bottom: [#9677DE, #7E5CCB, #D98E20][index];
    out property <color> slit: [#F6F0FF, #F6F0FF, #FFFDF0][index];
    out property <color> up-arrow: [#5B3FA8, #FFFFFF, #859900][index];
    out property <color> fab: [#B79CF0, #6B3FC4, #93953E][index];
    out property <color> fab-fg: [#16101F, #FFFFFF, #FFFFFF][index];
    out property <color> strip: [#2B2140, #E2D8F3, #403F38][index];
    out property <color> strip-thumb: [#EDE7F7, #6B3FC4, #FFFFFF][index];
    out property <color> selected: [#3A2B5C, #DCCBF7, #44442A][index];
    out property <color> press: [#241A38, #EADFF8, #22221A][index];
    out property <color> dialog: [#2A1F42, #FFFFFF, #2E2E26][index];
    out property <color> accent: [#B79CF0, #6B3FC4, #A9AC4A][index];
    out property <color> divider: [#3A2B5C, #D9CDEE, #3E3E32][index];
    out property <color> select-bar: [#4B3A78, #4B2A99, #4A4B24][index];
    out property <color> input-bg: [#1D1530, #F1EBFA, #232319][index];
}
